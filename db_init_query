/*테이블 생성 규칙
1. 아래 컬럼 사용할 것
    CREATED_AT          DATE            DEFAULT SYSDATE NOT NULL,
    CREATED_BY          VARCHAR2(50),
    UPDATED_AT          DATE,
    UPDATED_BY          VARCHAR2(50),
2. 컬럼 네이밍
CODE, DATE, NAME 등... 간단한 이름은 CD,DT,NM과 같은걸로 줄이지 말 것
;
*/

/* =========================================================
   사용자 마스터 테이블
   ========================================================= */
DROP TABLE MST_USER PURGE;
CREATE TABLE MST_USER (
    USER_ID             VARCHAR2(50)    NOT NULL,
    USER_PW             VARCHAR2(200)   NOT NULL,
    USER_NAME           VARCHAR2(100)   NOT NULL,
    ROLE_CODE           VARCHAR2(20)    NOT NULL,
    USE_YN              CHAR(1)         DEFAULT 'Y' NOT NULL,
    LAST_LOGIN_DATE       DATE,
    CREATED_AT          DATE            DEFAULT SYSDATE NOT NULL,
    CREATED_BY          VARCHAR2(50),
    UPDATED_AT          DATE,
    UPDATED_BY          VARCHAR2(50),

    CONSTRAINT PK_MST_USER PRIMARY KEY (USER_ID),
    CONSTRAINT FK_MST_USER_01 FOREIGN KEY (ROLE_CODE) REFERENCES MST_ROLE (ROLE_CODE)
);

COMMENT ON TABLE MST_USER IS '사용자 마스터';

COMMENT ON COLUMN MST_USER.USER_ID IS '사용자 아이디';
COMMENT ON COLUMN MST_USER.USER_PW IS '비밀번호';
COMMENT ON COLUMN MST_USER.USER_NAME IS '사용자명';
COMMENT ON COLUMN MST_USER.ROLE_CODE IS '권한 코드';
COMMENT ON COLUMN MST_USER.USE_YN IS '사용 여부';
COMMENT ON COLUMN MST_USER.LAST_LOGIN_DATE IS '최종 로그인 일시';
COMMENT ON COLUMN MST_USER.CREATED_AT IS '생성 일시';
COMMENT ON COLUMN MST_USER.CREATED_BY IS '생성자';
COMMENT ON COLUMN MST_USER.UPDATED_AT IS '수정 일시';
COMMENT ON COLUMN MST_USER.UPDATED_BY IS '수정자';




/* =========================================================
   권한 마스터 테이블
   ========================================================= */
drop table MAP_ROLE_MENU purge;
drop table MST_ROLE purge;
drop table MST_MENU purge;

CREATE TABLE MST_ROLE (
    ROLE_CODE           VARCHAR2(20)    NOT NULL,
    ROLE_NAME           VARCHAR2(100)   NOT NULL,
    ROLE_DESC           VARCHAR2(500),
    USE_YN              CHAR(1)         DEFAULT 'Y' NOT NULL,
    CREATED_AT          DATE            DEFAULT SYSDATE NOT NULL,
    CREATED_BY          VARCHAR2(50),
    UPDATED_AT          DATE,
    UPDATED_BY          VARCHAR2(50),
	CONSTRAINT PK_MST_ROLE PRIMARY KEY (ROLE_CODE)
);

COMMENT ON TABLE MST_ROLE IS '권한 마스터';

COMMENT ON COLUMN MST_ROLE.ROLE_CODE IS '권한 코드';
COMMENT ON COLUMN MST_ROLE.ROLE_NAME IS '권한명';
COMMENT ON COLUMN MST_ROLE.ROLE_DESC IS '권한 설명';
COMMENT ON COLUMN MST_ROLE.USE_YN IS '사용 여부';




/* =========================================================
   메뉴 마스터 테이블
   ========================================================= */
CREATE TABLE MST_MENU (
    MENU_ID             NUMBER          NOT NULL,
    PARENT_MENU_ID      NUMBER,
    MENU_NAME           VARCHAR2(100)   NOT NULL,
    MENU_URL            VARCHAR2(300),
    MENU_LEVEL          NUMBER(2)       DEFAULT 1 NOT NULL,
    SORT_ORDER          NUMBER(5)       DEFAULT 1 NOT NULL,
    ICON_NAME           VARCHAR2(100),
    USE_YN              CHAR(1)         DEFAULT 'Y' NOT NULL,
    CREATED_AT          DATE            DEFAULT SYSDATE NOT NULL,
    CREATED_BY          VARCHAR2(50),
    UPDATED_AT          DATE,
    UPDATED_BY          VARCHAR2(50),
    CONSTRAINT PK_MST_MENU PRIMARY KEY (MENU_ID)
);

COMMENT ON TABLE MST_MENU IS '메뉴 마스터';

COMMENT ON COLUMN MST_MENU.MENU_ID IS '메뉴 ID';
COMMENT ON COLUMN MST_MENU.PARENT_MENU_ID IS '상위 메뉴 ID';
COMMENT ON COLUMN MST_MENU.MENU_NAME IS '메뉴명';
COMMENT ON COLUMN MST_MENU.MENU_URL IS '메뉴 URL';
COMMENT ON COLUMN MST_MENU.MENU_LEVEL IS '메뉴 레벨';
COMMENT ON COLUMN MST_MENU.SORT_ORDER IS '정렬 순서';
COMMENT ON COLUMN MST_MENU.ICON_NAME IS '아이콘명';
COMMENT ON COLUMN MST_MENU.USE_YN IS '사용 여부';



/* =========================================================
   권한-메뉴 매핑 테이블
   ========================================================= */
CREATE TABLE MAP_ROLE_MENU (
    ROLE_CODE           VARCHAR2(20)    NOT NULL,
    MENU_ID             NUMBER          NOT NULL,
    READ_YN             CHAR(1)         DEFAULT 'Y' NOT NULL,
    CREATE_YN           CHAR(1)         DEFAULT 'N' NOT NULL,
    UPDATE_YN           CHAR(1)         DEFAULT 'N' NOT NULL,
    DELETE_YN           CHAR(1)         DEFAULT 'N' NOT NULL,
    EXCEL_YN           CHAR(1)         DEFAULT 'N' NOT NULL,
    CREATED_AT          DATE            DEFAULT SYSDATE NOT NULL,
    CREATED_BY          VARCHAR2(50),
    UPDATED_AT          DATE,
    UPDATED_BY          VARCHAR2(50),
    CONSTRAINT PK_MAP_ROLE_MENU PRIMARY KEY (ROLE_CODE, MENU_ID),
    CONSTRAINT FK_MAP_ROLE_MENU_01 FOREIGN KEY (ROLE_CODE) REFERENCES MST_ROLE (ROLE_CODE),
    CONSTRAINT FK_MAP_ROLE_MENU_02 FOREIGN KEY (MENU_ID) REFERENCES MST_MENU (MENU_ID)
);

COMMENT ON TABLE MAP_ROLE_MENU IS '권한별 메뉴 매핑';

COMMENT ON COLUMN MAP_ROLE_MENU.ROLE_CODE IS '권한 코드';
COMMENT ON COLUMN MAP_ROLE_MENU.MENU_ID IS '메뉴 ID';
COMMENT ON COLUMN MAP_ROLE_MENU.READ_YN IS '조회 권한 여부';
COMMENT ON COLUMN MAP_ROLE_MENU.CREATE_YN IS '등록 권한 여부';
COMMENT ON COLUMN MAP_ROLE_MENU.UPDATE_YN IS '수정 권한 여부';
COMMENT ON COLUMN MAP_ROLE_MENU.DELETE_YN IS '삭제 권한 여부';
COMMENT ON COLUMN MAP_ROLE_MENU.CREATED_AT IS '생성 일시';






