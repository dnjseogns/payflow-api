<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dhwon.payflow_api.api.auth.mapper.AuthMapper">

    <select id="login"
            parameterType="com.dhwon.payflow_api.api.auth.dto.AuthRequestDto"
            resultType="com.dhwon.payflow_api.api.auth.dto.AuthResponseDto">

        SELECT
        USER_ID
        , USER_NAME
        , ROLE_CODE
        FROM MST_USER
        WHERE USER_ID = #{dto.userId}
        AND USER_PW = #{dto.userPw}
        AND USE_YN = 'Y'

    </select>

</mapper>