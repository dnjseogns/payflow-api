<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dhwon.payflow_api.api.role.mapper.RoleMapper">

    <!-- 목록 조회 -->
    <select id="selectRoleList"
            resultType="com.dhwon.payflow_api.api.role.dto.RoleResponseDto">
        SELECT
        ROLE_CODE,
        ROLE_NAME,
        ROLE_DESC,
        USE_YN,
        CREATED_AT,
        CREATED_BY,
        UPDATED_AT,
        UPDATED_BY
        FROM MST_ROLE
        ORDER BY CREATED_AT DESC
    </select>

    <!-- 단건 조회 -->
    <select id="selectRoleDetail"
            resultType="com.dhwon.payflow_api.api.role.dto.RoleResponseDto">
        SELECT
        ROLE_CODE,
        ROLE_NAME,
        ROLE_DESC,
        USE_YN,
        CREATED_AT,
        CREATED_BY,
        UPDATED_AT,
        UPDATED_BY
        FROM MST_ROLE
        WHERE ROLE_CODE = #{roleCode}
    </select>

    <!-- INSERT -->
    <insert id="insertRole">
        INSERT INTO MST_ROLE
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dto.roleCode != null">ROLE_CODE,</if>
            <if test="dto.roleName != null">ROLE_NAME,</if>
            <if test="dto.roleDesc != null">ROLE_DESC,</if>
            <if test="dto.useYn != null">USE_YN,</if>
            CREATED_AT,
            CREATED_BY
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dto.roleCode != null">#{dto.roleCode},</if>
            <if test="dto.roleName != null">#{dto.roleName},</if>
            <if test="dto.roleDesc != null">#{dto.roleDesc},</if>
            <if test="dto.useYn != null">#{dto.useYn},</if>
            SYSDATE,
            #{loginUserId}
        </trim>
    </insert>

    <!-- UPDATE -->
    <update id="updateRole">
        UPDATE MST_ROLE
        <set>
            <if test="dto.roleName != null">ROLE_NAME = #{dto.roleName},</if>
            <if test="dto.roleDesc != null">ROLE_DESC = #{dto.roleDesc},</if>
            <if test="dto.useYn != null">USE_YN = #{dto.useYn},</if>
            UPDATED_AT = SYSDATE,
            UPDATED_BY = #{loginUserId}
        </set>
        WHERE ROLE_CODE = #{roleCode}
    </update>

    <!-- DELETE -->
    <delete id="deleteRole">
        DELETE FROM MST_ROLE
        WHERE ROLE_CODE = #{roleCode}
    </delete>

</mapper>