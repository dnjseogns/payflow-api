<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dhwon.payflow_api.api.merchant.mapper.MerchantMapper">

    <select id="selectMerchantList"
            resultType="com.dhwon.payflow_api.api.merchant.dto.MerchantSelectResponseDto">

        SELECT
        M.MERCHANT_ID,
        M.MERCHANT_NAME,
        M.MERCHANT_STATUS
        FROM MST_MERCHANT M
        ORDER BY M.MERCHANT_ID

    </select>

</mapper>